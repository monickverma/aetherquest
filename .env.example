# ─────────────────────────────────────────────────────────────
#  AetherQuest — environment template
#  Copy to `.env.local` and fill in. Never commit the real file.
# ─────────────────────────────────────────────────────────────

# Database (libSQL / SQLite-compatible)
# Local development — a plain file, no server needed:
DATABASE_URL="file:./data/aetherquest.db"
# Production (Turso) — looks like: libsql://your-db-name-org.turso.io
# DATABASE_URL="libsql://<your-db>.turso.io"

# Auth token for the remote database. Leave EMPTY for local file databases.
# Get it with: turso db tokens create <your-db>
DATABASE_AUTH_TOKEN=""

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Canonical public origin, used for SEO metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
